{
    "name": "NewsJS",
    "version": "1.0.0",
    "private": true,
    "description": "Учебная миграция rolling-scopes-school/news-JS на TypeScript",
    "license": "ISC",
    "engines": {
        "node": ">=22.14.0"
    },
    "scripts": {
        "start": "webpack serve --open --config webpack.config.js --env mode=dev",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --max-warnings=0",
        "build": "npm run typecheck && npm run lint && webpack --config webpack.config.js --env mode=prod"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "css-loader": "7.1.2",
        "dotenv-webpack": "8.1.1",
        "eslint": "10.14.0",
        "html-webpack-plugin": "5.6.5",
        "style-loader": "4.0.0",
        "ts-loader": "9.5.4",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.1",
        "webpack": "5.112.2",
        "webpack-cli": "6.0.1",
        "webpack-dev-server": "5.2.2",
        "webpack-merge": "6.0.1"
    }
}